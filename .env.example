# Copie para .env e ajuste. Reinicie o servidor depois de alterar.

# Pastas de vídeos por categoria: PASTA_VIDEOS_<CATEGORIA>=caminho1;caminho2
# Cada categoria vira uma seção na tela inicial, na ordem deste arquivo. Subpastas são incluídas.
# Caminhos relativos partem da pasta do projeto.
PASTA_VIDEOS_FILMES=filmes
PASTA_VIDEOS_SERIES=series
# OUTROS é especial: todo vídeo da pasta e das subpastas aparece como item solto, sem legendas.
PASTA_VIDEOS_OUTROS=C:\Users\SEU_USUARIO\Videos

# Busca de legendas online (OpenSubtitles). Chave em opensubtitles.com → perfil → API consumers.
# Usuário e senha são opcionais: sem login são 5 downloads por dia, com login (conta grátis) 20.
# OPENSUBTITLES_API_KEY=sua_chave
# OPENSUBTITLES_USUARIO=seu_usuario
# OPENSUBTITLES_SENHA=sua_senha
# Segunda fonte, usada junto (e quando o limite do OpenSubtitles acaba). Chave em subdl.com → painel da conta.
# SUBDL_API_KEY=sua_chave

# Porta do servidor (opcional, padrão 8765)
# PORTA=8765

# Caminhos do ffmpeg, se não estiverem no PATH (opcional)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
